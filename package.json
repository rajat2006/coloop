{
  "name": "coloop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --dir packages/coloop build",
    "ci:product": "pnpm run typecheck && pnpm run test && pnpm run build",
    "coloop": "pnpm --dir packages/coloop build && node packages/coloop/dist/cli.js",
    "test": "pnpm --dir packages/coloop test && pnpm --dir .sandcastle test",
    "typecheck": "pnpm --dir packages/coloop typecheck && pnpm --dir .sandcastle typecheck"
  }
}
